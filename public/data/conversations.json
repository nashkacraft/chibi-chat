  "nodes": [
    {
      "id": "start",
      "text": "Hi! I'm Kiko, do you have a minute to chat?",
      "choices": [
        {
          "id": "c1",
          "text": "Of course, hi Kiko!",
          "friendshipDelta": 10,
          "emotion": "happy",
          "nextId": "ask_how"
        },
        {
          "id": "c2",
          "text": "Let's chat. What's on your mind?",
          "friendshipDelta": 5,
          "emotion": "talk1",
          "nextId": "ask_how"
        },
        {
          "id": "c3",
          "text": "Not really, sorry.",
          "friendshipDelta": -50,
          "emotion": "sad",
          "nextId": "polite_end"
        }
      ]
    },
    {
      "id": "ask_how",
      "text": "I'm feeling excited today because I finished my drawing!",
      "choices": [
        {
          "id": "c4",
          "text": "That's awesome, show me!",
          "friendshipDelta": 20,
          "emotion": "veryhappy",
          "nextId": "show_art"
        },
        {
          "id": "c5",
          "text": "Nice, congrats!",
          "friendshipDelta": 5,
          "emotion": "happy",
          "nextId": "hobby_discuss"
        },
        {
          "id": "c6",
          "text": "I don't care about your drawing..",
          "friendshipDelta": -50,
          "emotion": "angry",
          "nextId": "hobby_discuss"
        }
      ]
    },
    {
      "id": "show_art",
       "text": "Kiko blushes and shows a tiny sketch. It looks cute, right? Do you like drawing too?",
      "choices": [
        {
          "id": "c7",
          "text": "Yes, I draw sometimes.",
          "friendshipDelta": 20,
          "emotion": "talk2",
          "nextId": "hobby_discuss"
        },
        {
          "id": "c8",
          "text": "Not really, but it's nice.",
          "friendshipDelta": 3,
          "emotion": "fake",
          "nextId": "hobby_discuss"
        },
        {
          "id": "c9",
          "text": "It looks... okay. I don't really like drawing though..",
          "friendshipDelta": -10,
          "emotion": "confusion",
          "nextId": "hobby_discuss"
        }
      ]
    },
    {
      "id": "hobby_discuss",
      "text": "I love tea and drawing. What's your favourite way to spend free time?",
      "choices": [
        {
          "id": "c10",
          "text": "I like reading and drawing.",
          "friendshipDelta": 10,
          "emotion": "veryhappy",
          "nextId": "deeper_1"
        },
        {
          "id": "c11",
          "text": "I play games and watch shows.",
          "friendshipDelta": 5,
          "emotion": "happy",
          "nextId": "deeper_1"
        },
        {
          "id": "c12",
          "text": "I like exploring... by the way, want to hear a secret?",
          "friendshipDelta": 20,
          "emotion": "creepy",
          "nextId": "secret_path",
          "secret": true
        }
      ]
    },
    {
      "id": "deeper_1",
      "text": "That sounds fun! Do you have any favourite stories or characters?",
      "choices": [
        {
          "id": "c13",
          "text": "I like shy characters.",
          "friendshipDelta": 5,
          "emotion": "smirk",
          "nextId": "deeper_2"
        },
        {
          "id": "c14",
          "text": "I like bold heroes.",
          "friendshipDelta": 10,
          "emotion": "happy",
          "nextId": "deeper_2"
        },
        {
          "id": "c15",
          "text": "I prefer slice-of-life stuff.",
          "friendshipDelta": -5,
          "emotion": "talk1",
          "nextId": "deeper_2"
        }
      ]
    },
    {
      "id": "deeper_2",
      "text": "We chat about stories for a while, Kiko seems to relax. Do you want to know her better?",
      "choices": [
        {
          "id": "c16",
          "text": "Let's exchange favourites.",
          "friendshipDelta": 12,
          "emotion": "veryhappy",
          "nextId": "deep_end"
        },
        {
          "id": "c17",
          "text": "Maybe later, I have to go now.",
          "friendshipDelta": -5,
          "emotion": "uncomfortable",
          "nextId": "polite_end"
        }
      ]
    },
    {
      "id": "secret_path",
      "text": "Kiko's eyes shine: 'A secret? Tell me!' She leans closer, eager to hear this secret of yours.",
      "choices": [
        {
          "id": "c18",
          "text": "I want you to be my friend.",
          "friendshipDelta": 100,
          "emotion": "creepy",
          "nextId": "deep_secret"
        },
        {
          "id": "c19",
          "text": "Uhh.. I changed my mind...",
          "friendshipDelta": -100,
          "emotion": "confusion",
          "nextId": "polite_end"
        }
      ]
    },
    {
      "id": "deep_secret",
      "text": "Kiko smiles.",
      "choices": [
        {
          "id": "c20",
          "text": "I want to be your friend!!!",
          "friendshipDelta": 100,
          "emotion": "veryhappy",
          "nextId": "deep_end"
        },
        {
          "id": "c21",
          "text": "I.. um.. nevermind.",
          "friendshipDelta": -50,
          "emotion": "uncomfortable",
          "nextId": "polite_end"
        }
      ]
    },
    {
      "id": "deep_end",
      "text": "The chat winds down. Kiko smiles and thanks you for the company.",
